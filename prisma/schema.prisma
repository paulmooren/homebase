generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  INVESTMENT
  LOAN
  MORTGAGE
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurringSource {
  MANUAL
  DETECTED
}

enum RecurringStatus {
  ACTIVE
  DISMISSED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  onboardedAt   DateTime?

  accounts            Account[]
  sessions            Session[]
  householdMember     HouseholdMember?
  ownedAccounts       FinancialAccount[] @relation("FinancialAccountOwner")
  createdInvites      HouseholdInvite[]
  ownedRecurringItems RecurringItem[]    @relation("RecurringItemOwner")
  ownedBudgets        Budget[]           @relation("BudgetOwner")
  ownedTasks          Task[]             @relation("TaskOwner")

  @@map("users")
}

// --- Household domain ---

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members           HouseholdMember[]
  invites           HouseholdInvite[]
  financialAccounts FinancialAccount[]
  categories        Category[]
  transactions      Transaction[]
  budgets           Budget[]
  recurringItems    RecurringItem[]
  netWorthSnapshots NetWorthSnapshot[]
  tasks             Task[]

  @@map("households")
}

model HouseholdMember {
  id          String   @id @default(cuid())
  householdId String
  userId      String   @unique
  joinedAt    DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("household_members")
}

model HouseholdInvite {
  id              String    @id @default(cuid())
  householdId     String
  code            String    @unique
  createdByUserId String?
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?

  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdByUser User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([householdId, revokedAt])
  @@map("household_invites")
}

// Auth.js adapter models (kept to the standard shape @auth/prisma-adapter expects).
// Must be named Account — @auth/prisma-adapter hard-codes `prisma.account`.
// Doesn't collide with the finance-domain FinancialAccount: distinct model names.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// --- Finance domain ---

model FinancialAccount {
  id                 String      @id @default(cuid())
  householdId        String
  ownerId            String?
  visibleToHousehold Boolean     @default(true)
  name               String
  institution        String?
  type               AccountType
  startingBalance    Decimal     @default(0) @db.Decimal(14, 2)
  balance            Decimal     @default(0) @db.Decimal(14, 2)
  currency           String      @default("EUR")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  household            Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  owner                User?           @relation("FinancialAccountOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  transactions         Transaction[]   @relation("AccountTransactions")
  incomingTransferTxns Transaction[]   @relation("TransferDestinationAccount")
  recurringItems       RecurringItem[] @relation("AccountRecurringItems")

  @@index([householdId])
  @@index([householdId, ownerId])
  @@map("financial_accounts")
}

model Category {
  id          String   @id @default(cuid())
  householdId String
  name        String
  color       String
  createdAt   DateTime @default(now())

  household      Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  budgets        Budget[]
  recurringItems RecurringItem[]

  @@unique([householdId, name])
  @@map("categories")
}

model Transaction {
  id                  String          @id @default(cuid())
  householdId         String
  accountId           String
  categoryId          String?
  type                TransactionType
  amount              Decimal         @db.Decimal(14, 2)
  date                DateTime        @db.Date
  merchant            String
  note                String?
  transferToAccountId String?
  createdAt           DateTime        @default(now())

  household         Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account           FinancialAccount  @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  category          Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transferToAccount FinancialAccount? @relation("TransferDestinationAccount", fields: [transferToAccountId], references: [id], onDelete: SetNull)

  @@index([householdId, date])
  @@index([accountId])
  @@map("transactions")
}

model Budget {
  id                 String   @id @default(cuid())
  householdId        String
  categoryId         String
  ownerId            String?
  // Sentinel mirror of `ownerId` (set to ownerId, or "HOUSEHOLD" when null) —
  // Postgres unique indexes treat NULL <> NULL, so a naive unique on
  // (householdId, categoryId, ownerId) would let duplicate household-wide
  // budgets slip through. Kept in sync with ownerId on every write.
  ownerScope         String   @default("HOUSEHOLD")
  visibleToHousehold Boolean  @default(true)
  monthlyAmount      Decimal  @db.Decimal(14, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  owner     User?     @relation("BudgetOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([householdId, categoryId, ownerScope])
  @@index([householdId, ownerId])
  @@map("budgets")
}

model RecurringItem {
  id                 String             @id @default(cuid())
  householdId        String
  ownerId            String?
  // The account this income/expense runs through. Its owner always matches
  // ownerId (set from the account on write); null = not linked to one.
  accountId          String?
  visibleToHousehold Boolean            @default(true)
  name               String
  type               TransactionType
  amount             Decimal            @db.Decimal(14, 2)
  frequency          RecurringFrequency
  categoryId         String?
  source             RecurringSource
  // The transaction merchant text this item was detected from, kept even
  // after the item is renamed so the same suggestion doesn't resurface.
  detectedName       String?
  status             RecurringStatus    @default(ACTIVE)
  lastSeenAt         DateTime?          @db.Date
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  household Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  owner     User?             @relation("RecurringItemOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  account   FinancialAccount? @relation("AccountRecurringItems", fields: [accountId], references: [id], onDelete: SetNull)
  category  Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([householdId, name])
  @@index([householdId, status])
  @@map("recurring_items")
}

model NetWorthSnapshot {
  id               String   @id @default(cuid())
  householdId      String
  date             DateTime @db.Date
  totalAssets      Decimal  @db.Decimal(14, 2)
  totalLiabilities Decimal  @db.Decimal(14, 2)
  netWorth         Decimal  @db.Decimal(14, 2)
  createdAt        DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, date])
  @@map("net_worth_snapshots")
}

model Task {
  id          String              @id @default(cuid())
  householdId String
  ownerId     String?
  title       String
  dueDate     DateTime?           @db.Date
  frequency   RecurringFrequency?
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  owner     User?     @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@map("tasks")
}
