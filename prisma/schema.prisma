generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  INVESTMENT
  LOAN
  MORTGAGE
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurringSource {
  MANUAL
  DETECTED
}

enum RecurringStatus {
  ACTIVE
  DISMISSED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  onboardedAt   DateTime?

  accounts            Account[]
  sessions            Session[]
  householdMember     HouseholdMember?
  ownedAccounts       FinancialAccount[]   @relation("FinancialAccountOwner")
  createdInvites      HouseholdInvite[]
  ownedRecurringItems RecurringItem[]      @relation("RecurringItemOwner")
  ownedBudgets        Budget[]             @relation("BudgetOwner")
  ownedTasks          Task[]               @relation("TaskOwner")
  ownedShoppingLists  ShoppingList[]       @relation("ShoppingListOwner")
  addedShoppingItems  ShoppingItem[]       @relation("ShoppingItemAddedBy")
  ownedWishes         Wish[]               @relation("WishOwner")
  claimedWishes       Wish[]               @relation("WishClaimer")
  ownedVaultEntries   VaultEntry[]         @relation("VaultEntryOwner")
  ownedReminders      Reminder[]           @relation("ReminderOwner")
  completedReminders  ReminderCompletion[] @relation("ReminderCompletedBy")
  pushSubscriptions   PushSubscription[]

  @@map("users")
}

// --- Household domain ---

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Module keys (see src/lib/modules.ts) the household has switched off. Stored
  // as the *off* list so a newly added module is on by default.
  disabledModules String[] @default([])

  members           HouseholdMember[]
  invites           HouseholdInvite[]
  financialAccounts FinancialAccount[]
  categories        Category[]
  transactions      Transaction[]
  budgets           Budget[]
  recurringItems    RecurringItem[]
  netWorthSnapshots NetWorthSnapshot[]
  tasks             Task[]
  shoppingLists     ShoppingList[]
  wishes            Wish[]
  vaultEntries      VaultEntry[]
  reminders         Reminder[]

  @@map("households")
}

model HouseholdMember {
  id              String   @id @default(cuid())
  householdId     String
  userId          String   @unique
  joinedAt        DateTime @default(now())
  // Whether the rest of the household can see this member's wishlist (and claim from it).
  wishlistVisible Boolean  @default(true)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("household_members")
}

model HouseholdInvite {
  id              String    @id @default(cuid())
  householdId     String
  code            String    @unique
  createdByUserId String?
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?

  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdByUser User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([householdId, revokedAt])
  @@map("household_invites")
}

// Auth.js adapter models (kept to the standard shape @auth/prisma-adapter expects).
// Must be named Account — @auth/prisma-adapter hard-codes `prisma.account`.
// Doesn't collide with the finance-domain FinancialAccount: distinct model names.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// --- Finance domain ---

model FinancialAccount {
  id                 String      @id @default(cuid())
  householdId        String
  ownerId            String?
  visibleToHousehold Boolean     @default(true)
  name               String
  institution        String?
  // The account's own IBAN, filled from bank exports. Lets the importer
  // recognise a move between two tracked accounts as a Transfer.
  iban               String?
  type               AccountType
  startingBalance    Decimal     @default(0) @db.Decimal(14, 2)
  balance            Decimal     @default(0) @db.Decimal(14, 2)
  currency           String      @default("EUR")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  household            Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  owner                User?           @relation("FinancialAccountOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  transactions         Transaction[]   @relation("AccountTransactions")
  incomingTransferTxns Transaction[]   @relation("TransferDestinationAccount")
  recurringItems       RecurringItem[] @relation("AccountRecurringItems")

  @@index([householdId])
  @@index([householdId, ownerId])
  @@map("financial_accounts")
}

model Category {
  id          String   @id @default(cuid())
  householdId String
  name        String
  color       String
  createdAt   DateTime @default(now())

  household      Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  budgets        Budget[]
  recurringItems RecurringItem[]

  @@unique([householdId, name])
  @@map("categories")
}

model Transaction {
  id                  String          @id @default(cuid())
  householdId         String
  accountId           String
  categoryId          String?
  type                TransactionType
  amount              Decimal         @db.Decimal(14, 2)
  date                DateTime        @db.Date
  merchant            String
  note                String?
  transferToAccountId String?
  // The other party as the bank reports it. Recognising a recurring item by
  // this is far steadier than by the free-text description.
  counterpartyIban    String?
  counterpartyName    String?
  createdAt           DateTime        @default(now())

  household         Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account           FinancialAccount  @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  category          Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transferToAccount FinancialAccount? @relation("TransferDestinationAccount", fields: [transferToAccountId], references: [id], onDelete: SetNull)

  @@index([householdId, date])
  @@index([accountId])
  @@map("transactions")
}

model Budget {
  id                 String   @id @default(cuid())
  householdId        String
  categoryId         String
  ownerId            String?
  // Sentinel mirror of `ownerId` (set to ownerId, or "HOUSEHOLD" when null) —
  // Postgres unique indexes treat NULL <> NULL, so a naive unique on
  // (householdId, categoryId, ownerId) would let duplicate household-wide
  // budgets slip through. Kept in sync with ownerId on every write.
  ownerScope         String   @default("HOUSEHOLD")
  visibleToHousehold Boolean  @default(true)
  monthlyAmount      Decimal  @db.Decimal(14, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  owner     User?     @relation("BudgetOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([householdId, categoryId, ownerScope])
  @@index([householdId, ownerId])
  @@map("budgets")
}

model RecurringItem {
  id                 String             @id @default(cuid())
  householdId        String
  ownerId            String?
  // The account this income/expense runs through. Its owner always matches
  // ownerId (set from the account on write); null = not linked to one.
  accountId          String?
  visibleToHousehold Boolean            @default(true)
  name               String
  type               TransactionType
  amount             Decimal            @db.Decimal(14, 2)
  frequency          RecurringFrequency
  categoryId         String?
  source             RecurringSource
  // The transaction merchant text this item was detected from, kept even
  // after the item is renamed so the same suggestion doesn't resurface.
  detectedName       String?
  status             RecurringStatus    @default(ACTIVE)
  lastSeenAt         DateTime?          @db.Date
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  household Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  owner     User?             @relation("RecurringItemOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  account   FinancialAccount? @relation("AccountRecurringItems", fields: [accountId], references: [id], onDelete: SetNull)
  category  Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([householdId, name])
  @@index([householdId, status])
  @@map("recurring_items")
}

model NetWorthSnapshot {
  id               String   @id @default(cuid())
  householdId      String
  date             DateTime @db.Date
  totalAssets      Decimal  @db.Decimal(14, 2)
  totalLiabilities Decimal  @db.Decimal(14, 2)
  netWorth         Decimal  @db.Decimal(14, 2)
  createdAt        DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, date])
  @@map("net_worth_snapshots")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id          String              @id @default(cuid())
  householdId String
  ownerId     String?
  title       String
  priority    TaskPriority        @default(MEDIUM)
  dueDate     DateTime?           @db.Date
  frequency   RecurringFrequency?
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  owner     User?     @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@map("tasks")
}

// Shared (ownerId null): every member sees and edits it. Private: only the
// owner. Deleting a member deletes their private lists with them.
model ShoppingList {
  id          String   @id @default(cuid())
  householdId String
  ownerId     String?
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  owner     User?              @relation("ShoppingListOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  items     ShoppingItem[]
  favorites ShoppingFavorite[]

  @@index([householdId])
  @@map("shopping_lists")
}

model ShoppingItem {
  id        String    @id @default(cuid())
  listId    String
  name      String
  note      String?
  // Free text so it can be "2", "500 g" or "1 L".
  quantity  String?
  // Ticked: shown under "In basket". Cleared: hidden from the list but kept
  // so past items can be suggested again.
  checkedAt DateTime?
  clearedAt DateTime?
  addedById String?
  createdAt DateTime  @default(now())

  list    ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  addedBy User?        @relation("ShoppingItemAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@index([listId])
  @@map("shopping_items")
}

// ownerId null is the shared "Home" wishlist. claimedById is never shown to
// the wish's owner (so gifts stay a surprise); on Home wishes it is visible
// to everyone. Deleting a member deletes their wishes with them.
model Wish {
  id          String    @id @default(cuid())
  householdId String
  ownerId     String?
  title       String
  url         String?
  price       Decimal?  @db.Decimal(14, 2)
  note        String?
  claimedById String?
  receivedAt  DateTime?
  createdAt   DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  owner     User?     @relation("WishOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  claimedBy User?     @relation("WishClaimer", fields: [claimedById], references: [id], onDelete: SetNull)

  @@index([householdId, ownerId])
  @@map("wishes")
}

// Titles, categories, labels and expiry dates are readable; the values inside
// `fields` ([{ label, value }]) and `noteEnc` are encrypted with the server's
// VAULT_KEY before they reach the database (see src/server/vault-crypto.ts and
// docs/adr/0001). ownerId null = Shared; Personal entries can be hidden from
// the household via visibleToHousehold. Deleted with their owner.
model VaultEntry {
  id                 String    @id @default(cuid())
  householdId        String
  ownerId            String?
  visibleToHousehold Boolean   @default(true)
  title              String
  category           String
  expiresOn          DateTime? @db.Date
  fields             Json
  noteEnc            String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  owner     User?     @relation("VaultEntryOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("vault_entries")
}

// Things a list's members regularly need, one tap away. Per list, so
// "Groceries" and "Pharmacy" keep their own.
model ShoppingFavorite {
  id        String   @id @default(cuid())
  listId    String
  name      String
  // No longer used — favorites carry no amount. Kept (nullable) so removing it
  // doesn't need a destructive migration while older deployments may still read it.
  quantity  String?
  createdAt DateTime @default(now())

  list ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, name])
  @@map("shopping_favorites")
}

enum ScheduleUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

// FROM_DONE: the next due date counts from the day it was done (flexible).
// FIXED: it keeps its rhythm whatever day it was done on.
enum ScheduleMode {
  FROM_DONE
  FIXED
}

// Recurring chores (hoovering, watering the plants). Always visible to the
// whole household; ownerId null means "Everyone". Deleting an assignee hands
// their reminders back to Everyone rather than deleting them.
model Reminder {
  id            String       @id @default(cuid())
  householdId   String
  ownerId       String?
  title         String
  intervalCount Int
  intervalUnit  ScheduleUnit
  mode          ScheduleMode @default(FROM_DONE)
  nextDueDate   DateTime     @db.Date
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  household   Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  owner       User?                @relation("ReminderOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  completions ReminderCompletion[]

  @@index([householdId, nextDueDate])
  @@map("reminders")
}

// One row per time a Reminder was done. dueDateAtCompletion lets a mis-tap be undone.
model ReminderCompletion {
  id                  String    @id @default(cuid())
  reminderId          String
  completedById       String?
  completedAt         DateTime  @default(now())
  dueDateAtCompletion DateTime? @db.Date

  reminder    Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  completedBy User?    @relation("ReminderCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([reminderId, completedAt])
  @@map("reminder_completions")
}

// One row per phone/browser that has switched notifications on. Removed
// automatically when the push service says the registration has expired.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// One row per day the daily reminder notifications were sent, so a retried or
// doubled scheduled run never notifies twice.
model NotificationRun {
  date      DateTime @id @db.Date
  createdAt DateTime @default(now())

  @@map("notification_runs")
}
