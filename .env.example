# Copy to .env and fill in. Neon's connection strings are pulled automatically
# by `neon deploy` / `neon link` into .env.local — see README.md.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Better Auth — generate the secret with: openssl rand -base64 32 (one per environment)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth — console.cloud.google.com > APIs & Services > Credentials >
# Create OAuth client ID (Web application). Redirect URI:
# <your-url>/api/auth/callback/google (Better Auth uses the same path as Auth.js did)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Vault encryption key — 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back it up outside the database: losing it makes Vault values unrecoverable.
VAULT_KEY=""

# Web push for reminder notifications — generate the pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:nest@getnest.eu"
# Protects /api/cron/*; Vercel sends it as a Bearer token to cron jobs.
CRON_SECRET=""
