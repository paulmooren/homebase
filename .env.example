# Copy to .env and fill in. Neon's connection strings are pulled automatically
# by `neon deploy` / `neon link` into .env.local — see README.md.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — console.cloud.google.com > APIs & Services > Credentials >
# Create OAuth client ID (Web application). Redirect URI:
# <your-url>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
