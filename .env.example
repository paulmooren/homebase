# Copy to .env and fill in. Neon's connection strings are pulled automatically
# by `neon deploy` / `neon link` into .env.local — see README.md.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Resend (magic-link email delivery) — https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="Kontor <onboarding@resend.dev>"
